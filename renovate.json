{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommits"],
  "schedule": ["before 6am on monday"],
  "timezone": "Asia/Jerusalem",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "zod must stay on the v3 line while on MCP SDK 1.x",
      "matchPackageNames": ["zod"],
      "allowedVersions": "<4.0.0"
    },
    {
      "description": "typescript tracks typescript-eslint's supported window",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "@types/node tracks the newest supported runtime (Docker/CI = Node 24 LTS)",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25.0.0"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  }
}
